// Prisma 数据模型定义
// 文档：https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 发票表：对应前端发票管理功能
/// 文件本身落盘到 backend/uploads/，数据库只存元数据与文件路径
model Invoice {
  id          String   @id @default(cuid())
  ownerName   String // 归属人（必填）
  fileName    String // 原始文件名
  fileType    String // MIME 类型，如 image/png、application/pdf
  invoiceDate DateTime // 发票日期（用户填写）
  uploadedAt  DateTime @default(now()) // 上传时间（系统记录）
  note        String? @db.Text // 备注（可选，自由文本，用 Text 避免 varchar 截断）
  storagePath String // 落盘后的相对路径，如 /uploads/inv-xxx.pdf
  parseStatus String   @default("pending") // 解析状态：pending | done | failed
  invoiceType String   @default("vat")  // 发票类型：vat(增值税普/专票) | train(铁路电子客票/火车票)
  parsedData  Json?                     // 本地解析（PDF/OFD）出的结构化字段
  parseError  String? @db.Text          // 解析失败时的错误信息（自由文本，用 Text 避免 P2000 截断）
  invoiceNumber String?                 // 解析出的发票号码（独立列，用于去重/查询，避免 JSON path 在 MySQL 下报错）
  fileHash     String?                 // 文件内容 sha256，用于幂等去重（同一文件重复上传只更新不新建）

  // 反向关系：一张发票可通过关联表挂到多条报销明细/行程段（支持 1:N 与 N:1）
  links InvoiceLink[]
  // 进项抵扣台账（1:1，抵扣动作是公司级，独立于报销关联）
  deduction InvoiceDeduction?

  @@index([invoiceNumber])
  @@map("invoices")
}

/// 进项抵扣台账（与发票 1:1）
/// 定位：本系统做「进项抵扣台账 + 申报底稿生成器」，不替代税务数字账户
/// （实际勾选动作仍在税务局平台手动完成，系统只记录状态并汇总）。
/// 可抵扣判定 + 税额计算由后端规则引擎（vatDeduction）基于发票 parsedData 算出，
/// 这里持久化计算结果 + 用户人工维护的勾选状态/申报所属期。
model InvoiceDeduction {
  id                  String   @id @default(cuid())
  invoiceId           String   @unique
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // ── 规则引擎算出的结果（发票重识别/批量重算后刷新）──
  /// 凭证类别标签（如 增值税专用发票 / 增值税普通发票 / 铁路电子客票 / 机动车销售统一发票 / 电子发票）
  voucherKind        String?
  /// 是否可抵扣（专票/数电专票/铁路电子客票/机动车/海关缴款书等可抵，普票不可抵）
  canDeduct          Boolean  @default(false)
  /// 税率（小数形式字符串，如 "0.13"；火车票固定 "0.09"）
  taxRate            String?
  /// 不含税金额
  taxExclusiveAmount String?
  /// 可抵扣进项税额
  deductibleTax       String?

  // ── 用户维护的状态（人工在台账页标记）──
  /// 勾选/抵扣状态：unconfirmed 未勾选 | selected 已勾选 | deducted 已申报抵扣 | transferred_out 进项转出
  status             String   @default("unconfirmed")
  /// 申报所属期，如 "2026-08"（用于按期汇总生成申报底稿）
  declarePeriod      String?
  /// 确认（勾选）时间
  confirmedAt        DateTime?
  /// 备注（如进项转出原因）
  note               String? @db.Text

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([declarePeriod])
  @@map("invoice_deductions")
}


/// 系统用户表：支持「超级管理员(admin) / 普通用户(user)」两级角色
/// 密码一律存 bcrypt 哈希，绝不保存明文
model User {
  id           String   @id @default(cuid())
  username     String   @unique // 登录账号，唯一
  name         String // 展示用姓名
  passwordHash String // bcrypt 哈希后的密码
  role         String   @default("user") // 'admin' | 'user'
  createdAt    DateTime @default(now())

  @@map("users")
}

/// 报销单主表：差旅费(travel) 与一般费用(general) 共用
/// 两类单的「共有骨架」(申请人/部门/总额/状态/附件/审批人) 放这里，
/// 差异部分拆到 ReimbursementItem(通用明细) / ReimbursementTrip+Leg(仅差旅)
/// 文件本身落盘到 backend/uploads/，数据库只存路径
model Reimbursement {
  id            String   @id @default(cuid())
  type          String // 'travel' | 'general'
  applicantName String // 申请人姓名（解析自 Excel）
  department    String? // 部门
  projectName   String? // 项目名称
  projectCode   String? // 项目编号
  applyDate     DateTime? // 申请日期（解析自 Excel，可能为 null）
  totalAmount   Decimal  @db.Decimal(10, 2) @default(0) // 由明细求和得出，不信任手写大写
  totalAmountText String? // 大写金额，仅展示
  status        String   @default("draft") // draft→submitted→approved/rejected→paid
  storagePath   String? // 原始 xlsx 落盘路径
  fileName      String? // 原始文件名
  submitterId   String? // 谁上传的（User.id）
  approverId    String? // 谁审批的（User.id）
  approvedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items ReimbursementItem[]
  trip  ReimbursementTrip?
  legs  ReimbursementTripLeg[]

  @@index([submitterId])
  @@index([status])
  @@map("reimbursements")
}

/// 通用费用明细：一般费用直接用；差旅的「费用汇总段」也复用它
model ReimbursementItem {
  id              String  @id @default(cuid())
  reimbursementId String
  seq             Int // 序号
  category        String? // 费用类型：办公费用/业务招待费/住宿费/伙食补助费...
  summary         String? // 摘要
  amount          Decimal @db.Decimal(10, 2)
  note            String?
  links           InvoiceLink[] // 关联的发票（通过发票关联表，支持 1:N）
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@map("reimbursement_items")
}

/// 差旅专用：出差信息（一对一）
model ReimbursementTrip {
  id              String  @id @default(cuid())
  reimbursementId String  @unique
  travelerName    String? // 出差人员
  startDate       DateTime?
  endDate         DateTime?
  fromLocation    String? // 出发地
  toLocation      String? // 目的地（可能多个，用 、 连接）
  headcount       Int? // 出差人数
  reason          String? // 出差事由
  dateRangeText   String? // 原始「起止时间」文本
  locationText    String? // 原始「起止地点」文本
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@map("reimbursement_trips")
}

/// 差旅专用：行程段（一对多，每段一行）
model ReimbursementTripLeg {
  id              String  @id @default(cuid())
  reimbursementId String
  legDate         String? // 如 "7/8"（解析自 Excel，保留原始文本）
  transport       String? // 高铁/飞机...
  fromStation     String?
  toStation       String?
  amount          Decimal @db.Decimal(10, 2) // 金额小计（单值）
  ticketCount     Int? // 单据张数
  links           InvoiceLink[] // 关联的发票（通过发票关联表，支持 1:N）
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@map("reimbursement_trip_legs")
}

/// 发票关联表（junction）：支持 1:1 / 1:N / N:1 三种关联模式
///  - 1:1 ：一行 ↔ 一张发票（一条记录）
///  - 1:N ：一行 ↔ 多张发票（多条记录，reimbursementItemId 相同、invoiceId 不同）
///  - N:1 ：一张发票 ↔ 多行（多条记录，invoiceId 相同、reimbursementItemId/LegId 不同），allocatedAmount 记录分摊额
model InvoiceLink {
  id                  String   @id @default(cuid())
  invoiceId           String
  invoice             Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reimbursementItemId String?
  reimbursementItem   ReimbursementItem? @relation(fields: [reimbursementItemId], references: [id], onDelete: Cascade)
  reimbursementLegId  String?
  reimbursementLeg    ReimbursementTripLeg? @relation(fields: [reimbursementLegId], references: [id], onDelete: Cascade)
  allocatedAmount     Decimal? @db.Decimal(10, 2) // N:1 分摊：本发票分摊到该行的金额；1:1/1:N 可为空
  note                String?
  createdAt           DateTime @default(now())

  // 同一行不会重复挂同一张发票（item 与 leg 各自独立唯一）
  @@unique([reimbursementItemId, invoiceId])
  @@unique([reimbursementLegId, invoiceId])
  @@index([invoiceId])
  @@map("invoice_links")
}
